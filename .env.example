# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Sender. Without a verified domain, Resend only allows onboarding@resend.dev.
RESEND_FROM=startingline <onboarding@resend.dev>
# Where the admin "Send test email" button delivers. Without a verified
# domain, Resend only lets you send to your own account email.
TEST_EMAIL_TO=you@example.com

# Session-signing secret (HMAC key for session cookies and emailed-link
# tokens). Rotating it signs everyone out. Historical name — admin access is
# role-based now, not password-based.
ADMIN_PASSWORD=choose-a-strong-secret

# Comma-separated emails auto-promoted to role='admin' at signup.
ADMIN_EMAILS=you@example.com

# Canonical origin baked into emailed links. Falls back to Vercel's
# production domain, then (dev only) the request's own host.
SITE_URL=https://your-domain.example

# Anthropic — digest editor. Optional; without it digests send raw headlines.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# sportsmarks.com — school identity/themes for tickets and digests.
SPORTSMARK_API_KEY=your-sportsmarks-key

# Shared secret the Monday digest cron sends as a Bearer token.
CRON_SECRET=choose-a-random-string
